{
  "name": "canopy",
  "version": "0.13.0-next.30",
  "description": "Developer terminal workstation",
  "main": "./out/main/index.js",
  "author": "ITSOL",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://canopy.itsol.tech",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && install-electron && generate-license-file -i package.json -o THIRD-PARTY-NOTICES --overwrite",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "test:e2e": "playwright test",
    "perf:startup": "CANOPY_PERF=1 npx playwright test perf/startup-bench.ts --config perf/playwright.perf.config.ts",
    "perf:memory": "CANOPY_PERF=1 npx playwright test perf/memory-leak.ts --config perf/playwright.perf.config.ts",
    "perf:ipc": "CANOPY_PERF=1 npx playwright test perf/ipc-monitor.ts --config perf/playwright.perf.config.ts",
    "perf:renderer": "CANOPY_PERF=1 npx playwright test perf/renderer-perf.ts --config perf/playwright.perf.config.ts",
    "perf:terminal-replay": "CANOPY_PERF=1 npx playwright test perf/terminal-replay.ts --config perf/playwright.perf.config.ts",
    "perf:cpu": "CANOPY_PERF=1 npx playwright test perf/cpu-profile.ts --config perf/playwright.perf.config.ts",
    "perf:all": "npm run perf:startup && npm run perf:memory && npm run perf:ipc && npm run perf:renderer && npm run perf:terminal-replay",
    "_perf:note": "perf:* scripts use Unix env var syntax (macOS/Linux only)"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.68.0",
    "@parcel/watcher": "^2.6.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@selemondev/svgl-svelte": "^2.17.0",
    "@tailwindcss/vite": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "fuzzysort": "^3.1.0",
    "marked": "^18.1.3",
    "neverthrow": "^8.2.0",
    "node-pty": "^1.1.0",
    "perfect-freehand": "^1.2.3",
    "qr-code-styling": "^1.9.2",
    "selfsigned": "^5.5.0",
    "semver": "^7.8.6",
    "simple-git": "^4.0.1",
    "simple-icons": "^16.36.0",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.2.4",
    "ts-pattern": "^5.9.2",
    "turndown": "^7.2.5",
    "undici": "^8.12.4",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "generate-license-file": "^4.2.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.6"
    }
  },
  "volta": {
    "node": "24.14.0"
  }
}
