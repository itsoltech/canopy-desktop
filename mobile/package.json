{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "ios": "expo start --dev-client --ios",
    "android": "expo start --dev-client --android",
    "web": "expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run lint",
    "doctor": "npx expo-doctor",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:sim": "eas build --profile development-simulator --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:run:sim": "eas build:run --platform ios --latest",
    "builds:list": "eas build:list --limit 10",
    "update:dev": "node ./scripts/eas-update-publish.mjs development",
    "update:prod": "node ./scripts/eas-update-publish.mjs production",
    "device:create": "eas device:create",
    "device:list": "eas device:list",
    "credentials": "eas credentials",
    "config:dev": "NODE_ENV=development expo config --json",
    "config:prod": "NODE_ENV=production expo config --json"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo/ui": "~56.0.18",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "^56",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@expo/cli": {
      "ws": "^8.20.1"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.6"
    },
    "@xmldom/xmldom": "^0.8.13",
    "postcss": "^8.5.10",
    "shell-quote": "^1.10.0",
    "xcode": {
      "uuid": "^14.0.0"
    }
  },
  "private": true,
  "volta": {
    "node": "22.20.0"
  }
}
